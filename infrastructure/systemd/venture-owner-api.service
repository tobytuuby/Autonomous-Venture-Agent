[Unit]
Description=Restricted owner review API (mTLS, loopback only)
After=network.target
ConditionPathExists=/etc/venture-owner-api.env

[Service]
Type=simple
User=venture-review
Group=venture-review
WorkingDirectory=/usr/local/lib/venture-review
Environment=PYTHONPATH=/usr/local/lib/venture-review
EnvironmentFile=/etc/venture-owner-api.env
ExecStart=/usr/bin/python3 -B -m agents.ceo.owner_api --discovery-db /var/lib/venture-review/inbox/discovery.sqlite --review-db /var/lib/venture-review/inbox/reviews.sqlite --host 127.0.0.1 --port 8792 --cert /etc/venture-owner-api/tls/server.crt --key /etc/venture-owner-api/tls/server.key --client-ca /etc/venture-owner-api/tls/client-ca.crt
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/venture-review/inbox
ReadOnlyPaths=/etc/venture-owner-api
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
