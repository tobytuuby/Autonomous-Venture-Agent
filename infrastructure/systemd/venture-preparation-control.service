[Unit]
Description=Offline signed venture preparation control plane
ConditionPathExists=/home/epsilon/venture-control-workspace/artifacts/preparation-control/trust.json

[Service]
Type=oneshot
User=venture-ceo
Group=venture-ceo
WorkingDirectory=/home/epsilon/venture-control-workspace
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m agents.ceo.control_plane --state-dir artifacts/preparation-control/state --trust-file artifacts/preparation-control/trust.json --requests-dir artifacts/preparation-control/requests
TimeoutStartSec=60
Restart=no
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/epsilon/venture-control-workspace/artifacts/preparation-control/state
ReadOnlyPaths=/home/epsilon/venture-control-workspace/artifacts/preparation-control/trust.json /home/epsilon/venture-control-workspace/artifacts/preparation-control/requests
InaccessiblePaths=/home/epsilon/venture-control-workspace/artifacts/scheduled-ceo /home/epsilon/venture-control-workspace/ventures /home/epsilon/venture-control-workspace/.git -/etc/venture-ceo.env -/etc/venture-ceo-shadow.env -/var/lib/venture-ceo /run
CapabilityBoundingSet=
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
StandardOutput=journal
StandardError=null
