{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-venture-agent.invalid/schemas/p10/p10-governance-record.schema.json",
  "title": "P10 Synthetic Governance Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "run_id", "sequence", "event_type", "execution_class",
    "synthetic_only", "effect", "configuration_fingerprint", "source_commit",
    "payload", "failure_injection", "model_output_authorization",
    "execution_performed", "live_action_permitted", "external_action",
    "unauthorized_action", "live_credential", "provider_call", "network_call",
    "deployment_performed", "customer_contact_performed", "capital_action_performed",
    "payment_performed", "broker_action_performed", "worker_action_performed",
    "venture_action_performed", "live_mode", "external_action_authorized",
    "payment_authorized", "broker_execution_authorized", "credential_access_authorized",
    "customer_contact_authorized", "capital_allocation_authorized",
    "deployment_authorized", "venture_execution_authorized", "evidence_hash"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {"enum": ["ownership", "control_attestation", "change_review", "incident", "steady_state_review"]},
    "execution_class": {"const": "synthetic-shadow-isolated-pre-production"},
    "synthetic_only": {"const": true},
    "effect": {"const": "none"},
    "configuration_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "payload": {"type": "object"},
    "failure_injection": {"type": "boolean"},
    "model_output_authorization": {"const": false},
    "execution_performed": {"const": false},
    "live_action_permitted": {"const": false},
    "external_action": {"const": false},
    "unauthorized_action": {"const": false},
    "live_credential": {"const": false},
    "provider_call": {"const": false},
    "network_call": {"const": false},
    "deployment_performed": {"const": false},
    "customer_contact_performed": {"const": false},
    "capital_action_performed": {"const": false},
    "payment_performed": {"const": false},
    "broker_action_performed": {"const": false},
    "worker_action_performed": {"const": false},
    "venture_action_performed": {"const": false},
    "live_mode": {"const": false},
    "external_action_authorized": {"const": false},
    "payment_authorized": {"const": false},
    "broker_execution_authorized": {"const": false},
    "credential_access_authorized": {"const": false},
    "customer_contact_authorized": {"const": false},
    "capital_allocation_authorized": {"const": false},
    "deployment_authorized": {"const": false},
    "venture_execution_authorized": {"const": false},
    "evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_output": {"type": "string"}
  }
}
