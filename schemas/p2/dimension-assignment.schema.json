{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://autonomous-venture-agent.local/schemas/p2/dimension-assignment.schema.json",
  "title":"P2 Thesis Dimension Assignment",
  "type":"object","additionalProperties":false,
  "required":["assignment_id","dimension","value","normalized_evidence_id","raw_evidence_ids","evidence_type","taint_status","contradiction_status","reasoning","policy_version","configuration_fingerprint","created_at","actor","portfolio_scope","correlation_id","idempotency_key"],
  "properties":{
    "assignment_id":{"$ref":"common.schema.json#/$defs/id"},
    "dimension":{"type":"string","enum":["category","customer_segment","core_offer","monetization_model","acquisition_channel","assumptions"]},
    "value":{"type":"string","minLength":1},
    "normalized_evidence_id":{"$ref":"common.schema.json#/$defs/id"},
    "raw_evidence_ids":{"type":"array","minItems":1,"items":{"$ref":"common.schema.json#/$defs/id"}},
    "evidence_type":{"$ref":"common.schema.json#/$defs/evidence_type"},
    "taint_status":{"$ref":"common.schema.json#/$defs/taint_status"},
    "contradiction_status":{"type":"string","enum":["none","detected"]},
    "reasoning":{"type":"string","minLength":1},
    "policy_version":{"$ref":"common.schema.json#/$defs/policy_version"},
    "configuration_fingerprint":{"$ref":"common.schema.json#/$defs/hash"},
    "created_at":{"$ref":"common.schema.json#/$defs/timestamp"},
    "actor":{"$ref":"common.schema.json#/$defs/actor"},
    "portfolio_scope":{"$ref":"common.schema.json#/$defs/portfolio_scope"},
    "correlation_id":{"$ref":"common.schema.json#/$defs/id"},
    "idempotency_key":{"$ref":"common.schema.json#/$defs/id"}
  }
}