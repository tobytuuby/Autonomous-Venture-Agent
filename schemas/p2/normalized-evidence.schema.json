{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-venture-agent.local/schemas/p2/normalized-evidence.schema.json",
  "title": "P2 Normalized Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["normalized_evidence_id","raw_evidence_ids","source_hashes","evidence_type","taint_status","canonical_payload","normalized_hash","normalization_rule_id","normalization_policy_version","transformation_chain","freshness","contradiction_status","contradiction_ids","policy_version","configuration_fingerprint","created_at","actor","portfolio_scope","correlation_id","idempotency_key"],
  "properties": {
    "normalized_evidence_id": {"$ref": "common.schema.json#/$defs/id"},
    "raw_evidence_ids": {"type":"array","minItems":1,"items":{"$ref":"common.schema.json#/$defs/id"}},
    "source_hashes": {"type":"array","minItems":1,"items":{"$ref":"common.schema.json#/$defs/hash"}},
    "evidence_type": {"$ref":"common.schema.json#/$defs/evidence_type"},
    "taint_status": {"$ref":"common.schema.json#/$defs/taint_status"},
    "canonical_payload": {"type":"object"},
    "normalized_hash": {"$ref":"common.schema.json#/$defs/hash"},
    "normalization_rule_id": {"$ref":"common.schema.json#/$defs/id"},
    "normalization_policy_version": {"type":"string","minLength":1},
    "transformation_chain": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["operation","at","actor_id","raw_evidence_ids","source_hashes"],"properties":{"operation":{"type":"string","minLength":1},"at":{"$ref":"common.schema.json#/$defs/timestamp"},"actor_id":{"$ref":"common.schema.json#/$defs/id"},"raw_evidence_ids":{"type":"array","items":{"$ref":"common.schema.json#/$defs/id"}},"source_hashes":{"type":"array","items":{"$ref":"common.schema.json#/$defs/hash"}}}}},
    "freshness": {"type":"object","additionalProperties":false,"required":["captured_at","validated_at","max_age_seconds"],"properties":{"captured_at":{"$ref":"common.schema.json#/$defs/timestamp"},"validated_at":{"$ref":"common.schema.json#/$defs/timestamp"},"max_age_seconds":{"type":"integer","minimum":0}}},
    "contradiction_status": {"type":"string","enum":["none","detected","quarantined"]},
    "contradiction_ids": {"type":"array","items":{"$ref":"common.schema.json#/$defs/id"}},
    "policy_version": {"$ref":"common.schema.json#/$defs/policy_version"},
    "configuration_fingerprint": {"$ref":"common.schema.json#/$defs/hash"},
    "created_at": {"$ref":"common.schema.json#/$defs/timestamp"},
    "actor": {"$ref":"common.schema.json#/$defs/actor"},
    "portfolio_scope": {"$ref":"common.schema.json#/$defs/portfolio_scope"},
    "correlation_id": {"$ref":"common.schema.json#/$defs/id"},
    "idempotency_key": {"$ref":"common.schema.json#/$defs/id"}
  }
}