{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-venture-agent.local/schemas/p2/thesis-score.schema.json",
  "title": "P2 ThesisScore",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "score_id",
    "thesis_id",
    "total",
    "dimensions",
    "weights",
    "uncertainty",
    "evidence_ids",
    "reasons",
    "policy_version",
    "configuration_fingerprint",
    "created_at",
    "actor",
    "portfolio_scope",
    "correlation_id",
    "idempotency_key"
  ],
  "properties": {
    "score_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "thesis_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "total": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "dimensions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    },
    "weights": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "basis"
      ],
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "policy_version": {
      "$ref": "common.schema.json#/$defs/policy_version"
    },
    "configuration_fingerprint": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "portfolio_scope": {
      "$ref": "common.schema.json#/$defs/portfolio_scope"
    },
    "correlation_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "idempotency_key": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "score_computation_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "score_algorithm_version": {
      "type": "string",
      "minLength": 1
    },
    "input_fingerprint": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "dimension_contributions": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    },
    "score_reasoning": {
      "type": "string",
      "minLength": 1
    },
    "confidence_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "expected", "upper", "basis"],
      "properties": {
        "lower": {"type": "number", "minimum": 0, "maximum": 100},
        "expected": {"type": "number", "minimum": 0, "maximum": 100},
        "upper": {"type": "number", "minimum": 0, "maximum": 100},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "taint_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statuses", "strongest"],
      "properties": {
        "statuses": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/taint_status"}},
        "strongest": {"$ref": "common.schema.json#/$defs/taint_status"}
      }
    },
    "contradiction_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
