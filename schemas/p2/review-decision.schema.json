{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-venture-agent.local/schemas/p2/review-decision.schema.json",
  "title": "P2 ReviewDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "thesis_id",
    "decision",
    "rationale",
    "evidence_ids",
    "launch_authorized",
    "capital_authorized",
    "external_action_authorized",
    "policy_version",
    "configuration_fingerprint",
    "created_at",
    "actor",
    "portfolio_scope",
    "correlation_id",
    "idempotency_key"
  ],
  "properties": {
    "review_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "thesis_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "decision": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "needs_review"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "launch_authorized": {
      "const": false
    },
    "capital_authorized": {
      "const": false
    },
    "external_action_authorized": {
      "const": false
    },
    "policy_version": {
      "$ref": "common.schema.json#/$defs/policy_version"
    },
    "configuration_fingerprint": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "portfolio_scope": {
      "$ref": "common.schema.json#/$defs/portfolio_scope"
    },
    "correlation_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "idempotency_key": {
      "$ref": "common.schema.json#/$defs/id"
    }
  }
}
