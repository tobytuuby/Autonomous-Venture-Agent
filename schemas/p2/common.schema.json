{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-venture-agent.local/schemas/p2/common.schema.json",
  "title": "P2 Common Contract Definitions",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policy_version": {
      "type": "string",
      "pattern": "^p2\\.\\d+$"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "external",
        "synthetic",
        "inferred",
        "operator"
      ]
    },
    "taint_status": {
      "type": "string",
      "enum": [
        "tainted",
        "trusted",
        "declassified"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "role"
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string",
          "enum": [
            "ceo-shadow",
            "p2-service",
            "human-operator",
            "system"
          ]
        }
      }
    },
    "portfolio_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portfolio_id"
      ],
      "properties": {
        "portfolio_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "configuration_fingerprint",
        "created_at",
        "actor",
        "portfolio_scope",
        "correlation_id",
        "idempotency_key"
      ],
      "properties": {
        "policy_version": {
          "$ref": "#/$defs/policy_version"
        },
        "configuration_fingerprint": {
          "$ref": "#/$defs/hash"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "portfolio_scope": {
          "$ref": "#/$defs/portfolio_scope"
        },
        "correlation_id": {
          "$ref": "#/$defs/id"
        },
        "idempotency_key": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
