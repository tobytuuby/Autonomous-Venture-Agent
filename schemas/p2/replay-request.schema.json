{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-venture-agent.local/schemas/p2/replay-request.schema.json",
  "title": "P2 ReplayRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replay_id",
    "target_decision_id",
    "source_record_ids",
    "expected_policy_version",
    "expected_configuration_fingerprint",
    "mode",
    "requested_at",
    "actor",
    "portfolio_scope",
    "correlation_id",
    "idempotency_key",
    "policy_version",
    "configuration_fingerprint",
    "created_at",
    "external_action_authorized"
  ],
  "properties": {
    "replay_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "target_decision_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "source_record_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "expected_policy_version": {
      "$ref": "common.schema.json#/$defs/policy_version"
    },
    "expected_configuration_fingerprint": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "mode": {
      "type": "string",
      "enum": [
        "verify",
        "reproduce"
      ]
    },
    "requested_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "portfolio_scope": {
      "$ref": "common.schema.json#/$defs/portfolio_scope"
    },
    "correlation_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "idempotency_key": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "policy_version": {
      "$ref": "common.schema.json#/$defs/policy_version"
    },
    "configuration_fingerprint": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "external_action_authorized": {
      "const": false
    }
  }
}
