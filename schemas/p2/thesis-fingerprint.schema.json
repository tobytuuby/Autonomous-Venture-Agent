{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-venture-agent.local/schemas/p2/thesis-fingerprint.schema.json",
  "title": "P2 ThesisFingerprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "thesis_id",
    "opportunity_id",
    "fingerprint",
    "category",
    "customer_segment",
    "core_offer",
    "monetization_model",
    "acquisition_channel",
    "assumptions",
    "policy_version",
    "configuration_fingerprint",
    "created_at",
    "actor",
    "portfolio_scope",
    "correlation_id",
    "idempotency_key"
  ],
  "properties": {
    "thesis_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "opportunity_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "fingerprint": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "customer_segment": {
      "type": "string",
      "minLength": 1
    },
    "core_offer": {
      "type": "string",
      "minLength": 1
    },
    "monetization_model": {
      "type": "string",
      "minLength": 1
    },
    "acquisition_channel": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "policy_version": {
      "$ref": "common.schema.json#/$defs/policy_version"
    },
    "configuration_fingerprint": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "portfolio_scope": {
      "$ref": "common.schema.json#/$defs/portfolio_scope"
    },
    "correlation_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "idempotency_key": {
      "$ref": "common.schema.json#/$defs/id"
    }
  }
}
