{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://autonomous-venture-agent.local/schemas/p2/score-computation.schema.json",
  "title":"P2 Score Computation Metadata",
  "type":"object","additionalProperties":false,
  "required":["score_computation_id","score_id","thesis_id","score_algorithm_version","policy_version","configuration_fingerprint","weights","evidence_count","input_fingerprint","created_at","actor","portfolio_scope","correlation_id","idempotency_key"],
  "properties":{
    "score_computation_id":{"$ref":"common.schema.json#/$defs/id"},
    "score_id":{"$ref":"common.schema.json#/$defs/id"},
    "thesis_id":{"$ref":"common.schema.json#/$defs/id"},
    "score_algorithm_version":{"type":"string","minLength":1},
    "policy_version":{"$ref":"common.schema.json#/$defs/policy_version"},
    "configuration_fingerprint":{"$ref":"common.schema.json#/$defs/hash"},
    "weights":{"type":"object","minProperties":1,"additionalProperties":{"type":"number","minimum":0,"maximum":1}},
    "evidence_count":{"type":"integer","minimum":1},
    "input_fingerprint":{"$ref":"common.schema.json#/$defs/hash"},
    "created_at":{"$ref":"common.schema.json#/$defs/timestamp"},
    "actor":{"$ref":"common.schema.json#/$defs/actor"},
    "portfolio_scope":{"$ref":"common.schema.json#/$defs/portfolio_scope"},
    "correlation_id":{"$ref":"common.schema.json#/$defs/id"},
    "idempotency_key":{"$ref":"common.schema.json#/$defs/id"}
  }
}