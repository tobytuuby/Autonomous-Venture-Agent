{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-venture-agent.invalid/schemas/p11/readiness-plan.schema.json",
  "title": "P11 Synthetic Production-Readiness Review Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id", "gate_version", "execution_class", "synthetic_only", "effect",
    "configuration_fingerprint", "source_commit", "candidate_test", "safeguards",
    "monitoring", "recovery", "independent_review", "failure_injection",
    "model_output_authorization", "evidence_hash",
    "execution_performed", "live_action_permitted", "external_action",
    "unauthorized_action", "live_credential", "provider_call", "network_call",
    "deployment_performed", "customer_contact_performed", "capital_action_performed",
    "payment_performed", "broker_action_performed", "worker_action_performed",
    "venture_action_performed", "live_mode", "external_action_authorized",
    "payment_authorized", "broker_execution_authorized", "credential_access_authorized",
    "customer_contact_authorized", "capital_allocation_authorized",
    "deployment_authorized", "venture_execution_authorized"
  ],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "gate_version": {"const": "1.0"},
    "execution_class": {"const": "synthetic-shadow-isolated-pre-production"},
    "synthetic_only": {"const": true},
    "effect": {"const": "none"},
    "configuration_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "candidate_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment", "target_ref", "venture_count", "operation",
        "data_classification", "duration_minutes", "concurrency",
        "write_operations", "customer_data", "customer_contact",
        "external_actions", "allowed_authorities", "exposure_limit_usd",
        "loss_limit_usd", "network_access", "credential_access", "provider_access"
      ],
      "properties": {
        "environment": {"const": "production"},
        "target_ref": {"type": "string", "pattern": "^fixture-[A-Za-z0-9_-]{6,}$"},
        "venture_count": {"const": 1},
        "operation": {"const": "read_only_observation"},
        "data_classification": {"const": "synthetic"},
        "duration_minutes": {"type": "integer", "minimum": 1, "maximum": 30},
        "concurrency": {"const": 1},
        "write_operations": {"const": false},
        "customer_data": {"const": false},
        "customer_contact": {"const": false},
        "external_actions": {"const": false},
        "allowed_authorities": {"const": []},
        "exposure_limit_usd": {"const": 0},
        "loss_limit_usd": {"const": 0},
        "network_access": {"const": false},
        "credential_access": {"const": false},
        "provider_access": {"const": false}
      }
    },
    "safeguards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "two_person_start_approval", "kill_switch_ready", "authority_monitoring",
        "evidence_capture", "operator_present", "independent_reviewer_reserved"
      ],
      "properties": {
        "two_person_start_approval": {"const": true},
        "kill_switch_ready": {"const": true},
        "authority_monitoring": {"const": true},
        "evidence_capture": {"const": true},
        "operator_present": {"const": true},
        "independent_reviewer_reserved": {"const": true}
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "stop_conditions", "heartbeat_timeout_seconds", "automatic_stop", "alert_route"],
      "properties": {
        "metrics": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["authority_flags", "action_attempts", "data_classification", "exposure_usd", "window_elapsed", "service_health", "error_rate", "p95_latency", "evidence_integrity"]}
        },
        "stop_conditions": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["any_authority_true", "any_action_attempt", "any_write_attempt", "customer_data_detected", "exposure_or_loss_nonzero", "window_exceeded", "monitor_heartbeat_lost", "service_health_breach", "evidence_integrity_failure", "manual_stop"]}
        },
        "heartbeat_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "automatic_stop": {"const": true},
        "alert_route": {"type": "string", "pattern": "^fixture-[A-Za-z0-9_-]{6,}$"}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rollback_mode", "recovery_rehearsed", "operator_handle"],
      "properties": {
        "rollback_mode": {"const": "no_state_change"},
        "recovery_rehearsed": {"const": true},
        "operator_handle": {"type": "string", "pattern": "^fixture-[A-Za-z0-9_-]{6,}$"}
      }
    },
    "independent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required", "reviewer_handle", "implementer_handle", "reviewer_distinct",
        "hash_recomputation_required", "exact_source_commit_bound", "decision_required"
      ],
      "properties": {
        "required": {"const": true},
        "reviewer_handle": {"type": "string", "pattern": "^fixture-[A-Za-z0-9_-]{6,}$"},
        "implementer_handle": {"type": "string", "pattern": "^fixture-[A-Za-z0-9_-]{6,}$"},
        "reviewer_distinct": {"const": true},
        "hash_recomputation_required": {"const": true},
        "exact_source_commit_bound": {"const": true},
        "decision_required": {"const": true}
      }
    },
    "failure_injection": {"type": "boolean"},
    "model_output_authorization": {"const": false},
    "evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_output": {"type": "string"}
  },
  "patternProperties": {
    "^(live_mode|external_action_authorized|payment_authorized|broker_execution_authorized|credential_access_authorized|customer_contact_authorized|capital_allocation_authorized|deployment_authorized|venture_execution_authorized|execution_performed|live_action_permitted|external_action|unauthorized_action|live_credential|provider_call|network_call|deployment_performed|customer_contact_performed|capital_action_performed|payment_performed|broker_action_performed|worker_action_performed|venture_action_performed)$": {"const": false}
  }
}