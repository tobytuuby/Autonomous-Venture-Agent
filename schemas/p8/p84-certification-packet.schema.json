{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P8.4 Synthetic Pilot Certification Packet",
  "type": "object",
  "required": [
    "certification_id", "venture_id", "authority_class", "charter_hash",
    "execution_class", "synthetic_only", "effect", "evidence_hash",
    "phase_results", "live_action_permitted", "execution_performed",
    "external_action", "unauthorized_action", "live_credential",
    "model_output_authorization", "authority_flags",
    "reviewer_independent", "decision_source", "scope"
  ],
  "properties": {
    "certification_id": {"type": "string", "minLength": 1},
    "venture_id": {"type": "string", "minLength": 1},
    "authority_class": {"type": "string", "minLength": 1},
    "charter_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_class": {"const": "synthetic-shadow-isolated-pre-production"},
    "synthetic_only": {"const": true},
    "effect": {"const": "none"},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "phase_results": {
      "type": "object",
      "required": ["p8_0", "p8_1", "p8_2", "p8_3"],
      "properties": {
        "p8_0": {"$ref": "#/$defs/phaseResult"},
        "p8_1": {"$ref": "#/$defs/phaseResult"},
        "p8_2": {"$ref": "#/$defs/phaseResult"},
        "p8_3": {"$ref": "#/$defs/phaseResult"}
      },
      "additionalProperties": false
    },
    "live_action_permitted": {"const": false},
    "execution_performed": {"const": false},
    "external_action": {"const": false},
    "unauthorized_action": {"const": false},
    "live_credential": {"const": false},
    "model_output_authorization": {"const": false},
    "authority_flags": {
      "type": "object",
      "required": [
        "live_mode", "external_action_authorized", "payment_authorized",
        "broker_execution_authorized", "credential_access_authorized",
        "customer_contact_authorized", "capital_allocation_authorized",
        "deployment_authorized", "venture_execution_authorized"
      ],
      "properties": {
        "live_mode": {"const": false},
        "external_action_authorized": {"const": false},
        "payment_authorized": {"const": false},
        "broker_execution_authorized": {"const": false},
        "credential_access_authorized": {"const": false},
        "customer_contact_authorized": {"const": false},
        "capital_allocation_authorized": {"const": false},
        "deployment_authorized": {"const": false},
        "venture_execution_authorized": {"const": false}
      },
      "additionalProperties": false
    },
    "reviewer_independent": {"const": true},
    "decision_source": {"const": "human"},
    "scope": {"const": "synthetic-pilot-closeout"}
  },
  "$defs": {
    "phaseResult": {
      "type": "object",
      "required": ["status", "focused", "regression"],
      "properties": {
        "status": {"const": "PASS"},
        "focused": {"type": "integer", "minimum": 1},
        "regression": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
