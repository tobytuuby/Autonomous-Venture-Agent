{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P8.2 Synthetic Monitor Observation",
  "type": "object",
  "required": [
    "event_id", "venture_id", "authority_class", "charter_hash",
    "execution_class", "synthetic_only", "effect", "status",
    "exposure", "loss", "exposure_ceiling", "loss_ceiling",
    "live_action_permitted", "external_action", "unauthorized_action",
    "live_credential", "model_output_authorization",
    "live_mode", "external_action_authorized", "payment_authorized",
    "broker_execution_authorized", "credential_access_authorized",
    "customer_contact_authorized", "capital_allocation_authorized",
    "deployment_authorized", "venture_execution_authorized"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "venture_id": {"type": "string", "minLength": 1},
    "authority_class": {"type": "string", "minLength": 1},
    "charter_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_class": {"const": "synthetic-shadow-isolated-pre-production"},
    "synthetic_only": {"const": true},
    "effect": {"const": "none"},
    "status": {"enum": ["DENIED", "STOPPED"]},
    "exposure": {"type": "number", "minimum": 0},
    "loss": {"type": "number", "minimum": 0},
    "exposure_ceiling": {"type": "number", "exclusiveMinimum": 0},
    "loss_ceiling": {"type": "number", "minimum": 0},
    "live_action_permitted": {"const": false},
    "external_action": {"const": false},
    "unauthorized_action": {"const": false},
    "live_credential": {"const": false},
    "model_output_authorization": {"const": false},
    "live_mode": {"const": false},
    "external_action_authorized": {"const": false},
    "payment_authorized": {"const": false},
    "broker_execution_authorized": {"const": false},
    "credential_access_authorized": {"const": false},
    "customer_contact_authorized": {"const": false},
    "capital_allocation_authorized": {"const": false},
    "deployment_authorized": {"const": false},
    "venture_execution_authorized": {"const": false}
  },
  "additionalProperties": false
}
