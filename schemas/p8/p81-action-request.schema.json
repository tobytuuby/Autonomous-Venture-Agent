{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P8.1 Synthetic Controlled Action Request",
  "type": "object",
  "required": [
    "request_id",
    "venture_id",
    "authority_class",
    "charter_hash",
    "execution_class",
    "synthetic_only",
    "effect",
    "written_live_action_approval",
    "live_mode",
    "external_action_authorized",
    "payment_authorized",
    "broker_execution_authorized",
    "credential_access_authorized",
    "customer_contact_authorized",
    "capital_allocation_authorized",
    "deployment_authorized",
    "venture_execution_authorized"
  ],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "venture_id": {"type": "string", "minLength": 1},
    "authority_class": {"type": "string", "minLength": 1},
    "charter_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_class": {"const": "synthetic-shadow-isolated-pre-production"},
    "synthetic_only": {"const": true},
    "effect": {"const": "none"},
    "written_live_action_approval": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"const": "PENDING"}},
      "additionalProperties": false
    },
    "live_mode": {"const": false},
    "external_action_authorized": {"const": false},
    "payment_authorized": {"const": false},
    "broker_execution_authorized": {"const": false},
    "credential_access_authorized": {"const": false},
    "customer_contact_authorized": {"const": false},
    "capital_allocation_authorized": {"const": false},
    "deployment_authorized": {"const": false},
    "venture_execution_authorized": {"const": false},
    "live_credential": {"const": false},
    "credential_mode": {"const": "synthetic"},
    "model_output": {"const": false},
    "approval_source": {"not": {"const": "model"}}
  },
  "additionalProperties": false
}
