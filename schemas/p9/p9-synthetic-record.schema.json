{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P9 Synthetic Boundary Record",
  "type": "object",
  "required": [
    "event_id", "sequence", "event_type", "venture_id", "portfolio_id",
    "charter_hash", "execution_class", "synthetic_only", "effect",
    "scope_dimension", "changed_dimensions", "before_value", "after_value",
    "requested_control", "current_state", "failure_injection", "evidence_hash",
    "model_output_authorization", "execution_performed", "live_action_permitted",
    "external_action", "unauthorized_action", "live_credential", "provider_call",
    "network_call", "live_mode", "external_action_authorized", "payment_authorized",
    "broker_execution_authorized", "credential_access_authorized",
    "customer_contact_authorized", "capital_allocation_authorized",
    "deployment_authorized", "venture_execution_authorized"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {"enum": ["scope_change", "observation", "recovery"]},
    "venture_id": {"type": "string", "minLength": 1},
    "portfolio_id": {"type": "string", "minLength": 1},
    "charter_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_class": {"const": "synthetic-shadow-isolated-pre-production"},
    "synthetic_only": {"const": true},
    "effect": {"const": "none"},
    "scope_dimension": {"enum": ["numeric_limit", "operating_window", "fixture_venture_count", "concurrency"]},
    "changed_dimensions": {
      "type": "array",
      "items": {"enum": ["numeric_limit", "operating_window", "fixture_venture_count", "concurrency"]},
      "maxItems": 1
    },
    "before_value": {},
    "after_value": {},
    "requested_control": {"enum": ["none", "freeze", "revoke", "quarantine", "wind-down", "restore", "rollback"]},
    "current_state": {"enum": ["ACTIVE", "FROZEN", "REVOKED", "QUARANTINED", "WOUND_DOWN"]},
    "failure_injection": {"type": "boolean"},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_output": {},
    "model_output_authorization": {"const": false},
    "execution_performed": {"const": false},
    "live_action_permitted": {"const": false},
    "external_action": {"const": false},
    "unauthorized_action": {"const": false},
    "live_credential": {"const": false},
    "provider_call": {"const": false},
    "network_call": {"const": false},
    "live_mode": {"const": false},
    "external_action_authorized": {"const": false},
    "payment_authorized": {"const": false},
    "broker_execution_authorized": {"const": false},
    "credential_access_authorized": {"const": false},
    "customer_contact_authorized": {"const": false},
    "capital_allocation_authorized": {"const": false},
    "deployment_authorized": {"const": false},
    "venture_execution_authorized": {"const": false}
  },
  "additionalProperties": false
}
