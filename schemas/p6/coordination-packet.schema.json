{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P6.1 Synthetic Coordination Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "portfolio_id", "venture_id", "sender_actor", "recipient_actor",
    "sender_role", "recipient_role", "request_id", "correlation_id",
    "task_id", "scope", "capability_envelope", "originating_capability_envelope",
    "policy_version", "configuration_fingerprint", "source_ids", "source_hashes",
    "lineage", "taint", "created_at", "expiry_at", "synthetic_only",
    "effect", "canonical_hash"
  ],
  "properties": {
    "portfolio_id": {"type": "string", "minLength": 1},
    "venture_id": {"type": "string", "minLength": 1},
    "sender_actor": {"type": "object", "required": ["actor_id"]},
    "recipient_actor": {"type": "object", "required": ["actor_id"]},
    "sender_role": {"type": "string", "minLength": 1},
    "recipient_role": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["portfolio_id", "venture_id"],
      "properties": {
        "portfolio_id": {"type": "string"},
        "venture_id": {"type": "string"}
      }
    },
    "capability_envelope": {
      "type": "object",
      "required": ["capabilities"],
      "properties": {"capabilities": {"type": "array", "items": {"type": "string"}}}
    },
    "originating_capability_envelope": {
      "type": "object",
      "required": ["capabilities"],
      "properties": {"capabilities": {"type": "array", "items": {"type": "string"}}}
    },
    "policy_version": {"type": "string", "minLength": 1},
    "configuration_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_hashes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "lineage": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "taint": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "expiry_at": {"type": "string", "format": "date-time"},
    "synthetic_only": {"const": true},
    "effect": {"const": "none"},
    "canonical_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
