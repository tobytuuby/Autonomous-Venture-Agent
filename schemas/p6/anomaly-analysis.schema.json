{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P6.3 Synthetic Aggregate Anomaly Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_id", "portfolio_id", "records", "policy_version",
    "configuration_fingerprint", "source_ids", "source_hashes", "lineage",
    "taint", "analyzed_at", "synthetic_only", "effect", "canonical_hash"
  ],
  "properties": {
    "analysis_id": {"type": "string", "minLength": 1},
    "portfolio_id": {"type": "string", "minLength": 1},
    "records": {"type": "array", "minItems": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "configuration_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_ids": {"type": "array", "minItems": 1},
    "source_hashes": {"type": "array", "minItems": 1},
    "lineage": {"type": "array", "minItems": 1},
    "taint": {"type": "array"},
    "analyzed_at": {"type": "string", "format": "date-time"},
    "synthetic_only": {"const": true},
    "effect": {"const": "none"},
    "canonical_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
