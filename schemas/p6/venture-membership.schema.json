{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-venture-agent.local/schemas/p6/venture-membership.schema.json",
  "title": "P6 Synthetic Venture Membership",
  "type": "object",
  "additionalProperties": false,
  "required": ["portfolio_id", "venture_id", "membership_state", "venture_scope",
    "private_metadata", "synthetic_only", "effect", "policy_version",
    "configuration_fingerprint", "created_at", "actor", "portfolio_scope",
    "correlation_id", "idempotency_key", "live_mode",
    "external_action_authorized", "payment_authorized",
    "broker_execution_authorized", "credential_access_authorized",
    "customer_contact_authorized", "capital_allocation_authorized",
    "deployment_authorized", "venture_execution_authorized"],
  "properties": {
    "portfolio_id": {"$ref": "common.schema.json#/$defs/id"},
    "venture_id": {"$ref": "common.schema.json#/$defs/id"},
    "membership_state": {"const": "member"},
    "venture_scope": {"type": "object", "required": ["portfolio_id"], "additionalProperties": false,
      "properties": {"portfolio_id": {"$ref": "common.schema.json#/$defs/id"}}},
    "private_metadata": {"type": "object"},
    "synthetic_only": {"const": true},
    "effect": {"const": "none"},
    "live_mode": {"const": false},
    "external_action_authorized": {"const": false},
    "payment_authorized": {"const": false},
    "broker_execution_authorized": {"const": false},
    "credential_access_authorized": {"const": false},
    "customer_contact_authorized": {"const": false},
    "capital_allocation_authorized": {"const": false},
    "deployment_authorized": {"const": false},
    "venture_execution_authorized": {"const": false},
    "policy_version": {"type": "string", "minLength": 1},
    "configuration_fingerprint": {"$ref": "common.schema.json#/$defs/hash"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "actor": {"$ref": "common.schema.json#/$defs/actor"},
    "portfolio_scope": {"$ref": "common.schema.json#/$defs/portfolio_scope"},
    "correlation_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1}
  }
}
