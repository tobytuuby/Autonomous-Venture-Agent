{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P6.4 Synthetic Operation Record",
  "type": "object",
  "required": ["action_id", "operation", "portfolio_id", "venture_id", "target_type", "configuration_fingerprint", "source_ids", "source_hashes", "lineage", "synthetic_only", "effect", "capability_granted"],
  "properties": {
    "action_id": {"type": "string", "minLength": 1},
    "operation": {"enum": ["freeze", "quarantine", "recover", "harvest", "reinvestment-proposal", "wind-down"]},
    "target_type": {"enum": ["venture", "service"]},
    "portfolio_id": {"type": "string", "minLength": 1},
    "venture_id": {"type": "string", "minLength": 1},
    "service_class": {"type": ["string", "null"]},
    "configuration_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_ids": {"type": "array", "minItems": 1},
    "source_hashes": {"type": "array", "minItems": 1},
    "lineage": {"type": "array", "minItems": 1},
    "synthetic_only": {"const": true},
    "effect": {"const": "none"},
    "capability_granted": {"const": false},
    "execution_requested": {"const": false},
    "capital_movement": {"const": false},
    "grant_revoked": {"type": "boolean"},
    "status": {"type": "string"}
  },
  "additionalProperties": true
}
