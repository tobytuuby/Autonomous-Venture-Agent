{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P6.4 Synthetic Operation Record",
  "type": "object",
  "required": ["action_id", "operation", "portfolio_id", "venture_id", "target_type", "policy_version", "configuration_fingerprint", "actor", "correlation_id", "idempotency_key", "source_ids", "source_hashes", "lineage", "evidence_hash", "canonical_hash", "record_hash", "synthetic_only", "effect", "capability_granted", "execution_requested", "capital_movement", "restores_authority"],
  "properties": {
    "action_id": {"type": "string", "minLength": 1},
    "operation": {"enum": ["freeze", "quarantine", "grant-revocation", "recover", "harvest", "reinvestment-proposal", "wind-down"]},
    "target_type": {"enum": ["venture", "service"]},
    "portfolio_id": {"type": "string", "minLength": 1},
    "venture_id": {"type": "string", "minLength": 1},
    "service_class": {"type": ["string", "null"]},
    "policy_version": {"type": "string", "minLength": 1},
    "actor": {"type": "object", "minProperties": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "configuration_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "canonical_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parent_action_id": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "lineage": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "synthetic_only": {"const": true},
    "effect": {"const": "none"},
    "capability_granted": {"const": false},
    "execution_requested": {"const": false},
    "capital_movement": {"const": false},
    "restores_authority": {"const": false},
    "grant_revoked": {"type": "boolean"},
    "status": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"operation": {"const": "grant-revocation"}},
        "required": ["operation"]
      },
      "then": {"required": ["parent_action_id"]}
    }
  ],
  "additionalProperties": true
}
