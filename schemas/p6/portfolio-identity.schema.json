{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-venture-agent.local/schemas/p6/portfolio-identity.schema.json",
  "title": "P6 Synthetic Portfolio Identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["portfolio_id", "name", "lifecycle_state", "synthetic_only", "effect",
    "policy_version", "configuration_fingerprint", "created_at", "actor",
    "portfolio_scope", "correlation_id", "idempotency_key",
    "live_mode", "external_action_authorized", "payment_authorized",
    "broker_execution_authorized", "credential_access_authorized",
    "customer_contact_authorized", "capital_allocation_authorized",
    "deployment_authorized", "venture_execution_authorized"],
  "properties": {
    "portfolio_id": {"$ref": "common.schema.json#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "lifecycle_state": {"const": "active-synthetic"},
    "synthetic_only": {"const": true},
    "effect": {"const": "none"},
    "policy_version": {"type": "string", "minLength": 1},
    "configuration_fingerprint": {"$ref": "common.schema.json#/$defs/hash"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "actor": {"$ref": "common.schema.json#/$defs/actor"},
    "portfolio_scope": {"$ref": "common.schema.json#/$defs/portfolio_scope"},
    "correlation_id": {"$ref": "common.schema.json#/$defs/id"},
    "idempotency_key": {"$ref": "common.schema.json#/$defs/id"},
    "live_mode": {"$ref": "common.schema.json#/$defs/false_authority"},
    "external_action_authorized": {"$ref": "common.schema.json#/$defs/false_authority"},
    "payment_authorized": {"$ref": "common.schema.json#/$defs/false_authority"},
    "broker_execution_authorized": {"$ref": "common.schema.json#/$defs/false_authority"},
    "credential_access_authorized": {"$ref": "common.schema.json#/$defs/false_authority"},
    "customer_contact_authorized": {"$ref": "common.schema.json#/$defs/false_authority"},
    "capital_allocation_authorized": {"$ref": "common.schema.json#/$defs/false_authority"},
    "deployment_authorized": {"$ref": "common.schema.json#/$defs/false_authority"},
    "venture_execution_authorized": {"$ref": "common.schema.json#/$defs/false_authority"}
  }
}
