{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P6.2 Synthetic Shared-Service Demand",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "demand_id", "portfolio_id", "venture_id", "coordination_request_id",
    "requester_actor", "service_class", "requested_units", "scope",
    "eligibility", "quota", "policy_version", "configuration_fingerprint",
    "source_ids", "source_hashes", "lineage", "taint", "created_at", "expiry_at",
    "synthetic_only", "effect", "canonical_hash"
  ],
  "properties": {
    "demand_id": {"type": "string", "minLength": 1},
    "portfolio_id": {"type": "string", "minLength": 1},
    "venture_id": {"type": "string", "minLength": 1},
    "coordination_request_id": {"type": "string", "minLength": 1},
    "requester_actor": {"type": "object", "required": ["actor_id"]},
    "service_class": {"type": "string", "minLength": 1},
    "requested_units": {"type": "integer", "minimum": 1},
    "scope": {
      "type": "object",
      "required": ["portfolio_id", "venture_id"]
    },
    "eligibility": {
      "type": "object",
      "required": ["eligible"],
      "properties": {"eligible": {"const": true}}
    },
    "quota": {
      "type": "object",
      "required": ["max_units"],
      "properties": {"max_units": {"type": "integer", "minimum": 1}}
    },
    "policy_version": {"type": "string", "minLength": 1},
    "configuration_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_hashes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "lineage": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "taint": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "expiry_at": {"type": "string", "format": "date-time"},
    "synthetic_only": {"const": true},
    "effect": {"const": "none"},
    "canonical_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
