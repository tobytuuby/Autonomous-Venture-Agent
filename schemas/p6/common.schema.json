{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-venture-agent.local/schemas/p6/common.schema.json",
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "minLength": 1},
    "false_authority": {"const": false},
    "timestamp": {"type": "string", "format": "date-time"},
    "actor": {"type": "object", "required": ["actor_id", "role"], "additionalProperties": false,
      "properties": {"actor_id": {"$ref": "#/$defs/id"}, "role": {"$ref": "#/$defs/id"}}},
    "portfolio_scope": {"type": "object", "required": ["portfolio_id"], "additionalProperties": false,
      "properties": {"portfolio_id": {"$ref": "#/$defs/id"}}}
  }
}
