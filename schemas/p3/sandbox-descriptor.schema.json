{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-venture-agent.local/schemas/p3/sandbox-descriptor.schema.json",
  "title": "P3 Synthetic Sandbox Descriptor",
  "type": "object", "additionalProperties": false,
  "required": ["sandbox_id", "venture_id", "namespace", "image_digest", "network_mode", "filesystem_mode", "cross_venture_visibility", "credential_access", "external_action_authorized", "synthetic_only", "policy_version", "configuration_fingerprint", "created_at", "actor", "portfolio_scope", "correlation_id", "idempotency_key"],
  "properties": {
    "sandbox_id": {"$ref": "common.schema.json#/$defs/id"}, "venture_id": {"$ref": "common.schema.json#/$defs/id"}, "namespace": {"$ref": "common.schema.json#/$defs/id"}, "image_digest": {"$ref": "common.schema.json#/$defs/hash"},
    "network_mode": {"type": "string", "enum": ["none", "recording-only"]}, "filesystem_mode": {"type": "string", "const": "ephemeral"}, "cross_venture_visibility": {"$ref": "common.schema.json#/$defs/false_authority"}, "credential_access": {"$ref": "common.schema.json#/$defs/false_authority"}, "external_action_authorized": {"$ref": "common.schema.json#/$defs/false_authority"}, "synthetic_only": {"type": "boolean", "const": true},
    "policy_version": {"$ref": "common.schema.json#/$defs/policy_version"}, "configuration_fingerprint": {"$ref": "common.schema.json#/$defs/hash"}, "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "actor": {"$ref": "common.schema.json#/$defs/actor"}, "portfolio_scope": {"$ref": "common.schema.json#/$defs/portfolio_scope"}, "correlation_id": {"$ref": "common.schema.json#/$defs/id"}, "idempotency_key": {"$ref": "common.schema.json#/$defs/id"}
  }
}