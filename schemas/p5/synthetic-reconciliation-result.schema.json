{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/p5/synthetic-reconciliation-result.schema.json",
  "title": "P5.1 Synthetic Reconciliation Result",
  "type": "object",
  "required": ["configuration_fingerprint", "source_event_ids", "source_event_hashes", "total_amount_minor", "reconciliation_hash", "status", "effect"],
  "properties": {
    "configuration_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_event_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "total_amount_minor": {"type": "integer", "minimum": 0},
    "reconciliation_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "RECONCILED"},
    "effect": {"const": "none"},
    "external_action_authorized": {"const": false},
    "provenance": {"type": "array", "minItems": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
