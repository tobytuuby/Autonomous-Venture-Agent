{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-venture-agent.local/schemas/p7/worker-boundary.schema.json",
  "title": "P7.5 Synthetic Worker Boundary Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "worker_id", "manager_id", "venture_id", "portfolio_id", "archetype_id",
    "capabilities", "originating_capabilities", "policy_version",
    "configuration_fingerprint", "environment_identity", "provenance",
    "correlation_id", "idempotency_key", "state", "synthetic_only",
    "effect", "cross_venture_visibility", "self_escalation_allowed"
  ],
  "properties": {
    "worker_id": {"type": "string", "minLength": 1},
    "manager_id": {"type": "string", "minLength": 1},
    "venture_id": {"type": "string", "minLength": 1},
    "portfolio_id": {"type": "string", "minLength": 1},
    "archetype_id": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "originating_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "policy_version": {"type": "string", "minLength": 1},
    "configuration_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "environment_identity": {"type": "string", "minLength": 1},
    "provenance": {"type": "object", "required": ["source_ids", "source_hashes", "lineage"]},
    "correlation_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "state": {"enum": ["ACTIVE", "FROZEN", "REVOKED", "QUARANTINED", "WOUND_DOWN"]},
    "synthetic_only": {"const": true},
    "effect": {"const": "none"},
    "cross_venture_visibility": {"const": false},
    "self_escalation_allowed": {"const": false}
  }
}
