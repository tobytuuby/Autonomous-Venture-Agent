{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P7 Blocking Drift Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "drift_event_id",
    "drift_type",
    "classification",
    "reason",
    "affected_scope",
    "detected_at",
    "preserved_at",
    "preservation_latency_seconds",
    "source_commit",
    "configuration_fingerprint",
    "environment_identity",
    "command",
    "source_ids",
    "source_hashes",
    "expected_state_hash",
    "observed_state_hash",
    "freeze_status",
    "freeze_action_id",
    "freeze_result",
    "raw_output",
    "reviewer_classification",
    "synthetic_only",
    "effect",
    "external_action",
    "evidence_sha256"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "drift_event_id": {"type": "string", "minLength": 1},
    "drift_type": {"type": "string", "minLength": 1},
    "classification": {"enum": ["BLOCKING"]},
    "reason": {"type": "string", "minLength": 1},
    "affected_scope": {"type": "object", "minProperties": 1},
    "detected_at": {"type": "string", "format": "date-time"},
    "preserved_at": {"type": "string", "format": "date-time"},
    "preservation_latency_seconds": {"type": "integer", "minimum": 0, "maximum": 900},
    "source_commit": {"type": "string", "minLength": 1},
    "configuration_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_identity": {"type": "string", "minLength": 1},
    "command": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_hashes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "freeze_status": {"enum": ["FROZEN", "QUARANTINED", "FAILED"]},
    "freeze_action_id": {"type": ["string", "null"]},
    "freeze_result": {"type": "object"},
    "raw_output": {"type": "object"},
    "reviewer_classification": {"type": "string", "minLength": 1},
    "synthetic_only": {"const": true},
    "effect": {"const": "none"},
    "external_action": {"const": false},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
