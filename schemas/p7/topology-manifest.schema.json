{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P7.1 Synthetic Topology Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "topology_id", "execution_class", "components", "allowed_edges"],
  "properties": {
    "schema_version": {"type": "string", "const": "p7.1-topology-v1"},
    "topology_id": {"type": "string", "minLength": 1},
    "execution_class": {"type": "string", "enum": ["synthetic", "shadow", "isolated-pre-production"]},
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component_id", "owner", "trust_zone", "synthetic_only"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "trust_zone": {"type": "string", "minLength": 1},
          "synthetic_only": {"const": true},
          "capabilities": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "allowed_edges": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {"type": "string"}, "to": {"type": "string"}, "external": {"const": false}
        }
      }
    },
    "forbidden_edges": {"type": "array", "items": {"type": "object"}}
  }
}